# 统一行尾：仓库内一律存 LF，避免 Windows 检出后 CRLF 破坏容器构建。
# 注意：shell 脚本 / Dockerfile / 容器配置若带上 CRLF，会在 Linux 容器内
# 报 "bad interpreter: /bin/bash^M" 或 Dockerfile 解析错误。

* text=auto

# 脚本与容器相关：强制 LF
*.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 构建脚本（Windows 侧）：保留 CRLF 以兼容 PowerShell
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
